# =============================================================================
# Sail Core — protocol-core deployment .env  (DeployCore.s.sol)
# -----------------------------------------------------------------------------
# Scope: TRUSTED CORE ONLY. Permission templates (DeploySharedTemplates.s.sol)
# are deployed in a SEPARATE step after this and are NOT covered here.
#
# CRITICAL: every value in the "IDENTICAL ON EVERY CHAIN" blocks below must be
# byte-for-byte identical across all chains, or the CREATE2 addresses diverge.
# Set every role address EXPLICITLY — do not rely on the "default: deployer"
# fallbacks (they make addresses depend on the deployer EOA, which may differ
# per chain).
# =============================================================================

# ── Broadcaster (an EOA — NOT the Safe; pays gas, holds no role) ─────────────
# The Safe cannot run a forge script. This EOA triggers the CREATE2 factory and
# does not enter any constructor arg, so it does not affect addresses or roles.
DEPLOYER_ADDRESS=0x
DEPLOYER_PRIVATE_KEY=0x

# ── ROLES — IDENTICAL ON EVERY CHAIN (constructor args) ──────────────────────
INITIAL_GOVERNANCE=0x          # admin Safe — governance + timelock proposer/executor
TREASURY=0x                    # treasury Safe — receives protocol cut
EMERGENCY_ADMIN=0x             # emergency Safe — can pause kernel (no timelock)
FEE_MANAGER=0x                 # admin Safe — tunes StandardFeePolicy
DISTRIBUTOR=0x0000000000000000000000000000000000000000

# ── IMMUTABLE FEE CEILING — IDENTICAL ON EVERY CHAIN, PERMANENT ──────────────
# NOT the registry fee. Baked in at deploy, can NEVER change. Must be <= 0.01 ether.
# Set to the constitutional ceiling, 0.01 of the native token. ETH / BNB / HYPE
# are all 18-decimal, so this single integer = 0.01 ETH / 0.01 BNB / 0.01 HYPE.
# Keep it identical everywhere so the CREATE2 addresses match.
MAX_PERMISSION_FEE_WEI=10000000000000000        # 0.01 * 1e18 (constitutional cap)

# ── FEES — IDENTICAL ON EVERY CHAIN ──────────────────────────────────────────
INITIAL_PERMISSION_REGISTRATION_FEE=150000000000000   # registry fee 0.00015 * 1e18; must be <= MAX_PERMISSION_FEE_WEI
MGMT_FEE_BPS=0
PERF_FEE_BPS=0
DISTRIBUTOR_BPS=0

# ── GENESIS ALLOWLIST BOOTSTRAP ──────────────────────────────────────────────
# LEAVE UNSET for the Safe-governed flow: governance is the admin Safe, so the
# in-script bootstrap (which requires governance == deployer) does NOT apply.
# Instead, after deploy the admin Safe submits one bootstrapAllowlists() tx per
# chain (onlyGovernance, not timelocked → no 48h wait). See docs/DEPLOYMENT.md §4.
# SAIL_BOOTSTRAP_ALLOWLISTS=1

# SafeProxy v1.4.1 runtime codehash. Consumed by the bootstrapAllowlists() Safe
# call. Same value on every chain. Capture once:
#   cast keccak "$(cast code <any-1.4.1-SafeProxy> --rpc-url $BASE_MAINNET_RPC_URL)"
SAFE_PROXY_CODEHASH=0x

# ── VERIFICATION (optional; one key works across chains via Etherscan v2) ────
# NOTE: foundry.toml has no [etherscan] entry for plasma or hyperliquid —
# verification on those chains needs separate handling. (bsc, world, and megaeth
# now have [etherscan] entries via Etherscan V2.)
ETHERSCAN_API_KEY=

# ── PROVENANCE / OPS (optional) ──────────────────────────────────────────────
# GIT_COMMIT=                  # set to $(git rev-parse HEAD) at deploy time
# SAIL_DEPLOY_FRESH=1          # allow overwriting an existing core.json (archive old first)

# ── RPC URLs (foundry.toml aliases reference these) ──────────────────────────
ETH_MAINNET_RPC_URL=           # alias: mainnet      (1)
SEPOLIA_RPC_URL=               # alias: sepolia      (11155111)
BASE_MAINNET_RPC_URL=          # alias: base         (8453)
BASE_SEPOLIA_RPC_URL=          # alias: base_sepolia (84532)
ARBITRUM_MAINNET_RPC_URL=      # alias: arbitrum     (42161)
OP_RPC_URL=                    # alias: optimism     (10)
UNICHAIN_RPC_URL=              # alias: unichain     (130)
HYPERLIQUID_RPC_URL=           # alias: hyperliquid  (HyperEVM, chain 999; no etherscan entry)
BSC_RPC_URL=                 # alias: bsc     (56)
WORLD_RPC_URL=               # alias: world   (480)
MEGAETHEREUM_RPC_URL=        # alias: megaeth (4326)